{
  "name": "it-asset-frontend",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder",
    "test": "node tests/workflow.cjs && node tests/performance.cjs && node tests/permissions.cjs && node tests/password-session.cjs",
    "format": "prettier --write src tests electron vite.config.js package.json",
    "format:check": "prettier --check src tests electron vite.config.js package.json"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "prettier": "3.6.2",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.itasset.app",
    "productName": "IT固定资产管理系统",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "packageManager": "npm@11.6.2"
}
